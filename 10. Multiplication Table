class Table {
    int num = 5;

    void printTable() {
        for (int i = 1; i <= 10; i++) {
            System.out.println(num + " x " + i + " = " + (num * i));
        }
    }
}

public class Main10 {
    public static void main(String[] args) {
        Table obj = new Table();
        obj.printTable();
    }
}
