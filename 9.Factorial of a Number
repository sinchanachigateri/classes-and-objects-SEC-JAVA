class Factorial {
    int n = 5;

    void calculate() {
        int fact = 1;
        for (int i = 1; i <= n; i++) {
            fact *= i;
        }
        System.out.println("Factorial of " + n + " is: " + fact);
    }
}

public class Main9 {
    public static void main(String[] args) {
        Factorial obj = new Factorial();
        obj.calculate();
    }
}
