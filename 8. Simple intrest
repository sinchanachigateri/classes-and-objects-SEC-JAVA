class SimpleInterest {
    double p = 5000, r = 5.5, t = 2;

    void calculate() {
        double si = (p * r * t) / 100;
        System.out.println("Simple Interest: " + si);
    }
}

public class Main8 {
    public static void main(String[] args) {
        SimpleInterest obj = new SimpleInterest();
        obj.calculate();
    }
}
